# Copy to .env for local runs. Never commit the copy.
#
# Values already present in the real environment always win over this file, so a
# cloud deployment ignores it entirely and uses its own service environment or
# Secret Manager bindings.

# Which surface the agents talk to: vertex-ai | gemini-api | openrouter
AR_MODEL_PROVIDER=vertex-ai

# Vertex AI express mode takes an API key. Without one, the vertex-ai provider
# falls back to Application Default Credentials and needs GOOGLE_CLOUD_PROJECT.
VERTEX_API_KEY=

# Gemini API (AR_MODEL_PROVIDER=gemini-api). Either name is accepted.
# GEMINI_API_KEY=

# OpenRouter (AR_MODEL_PROVIDER=openrouter).
# OPENROUTER_API_KEY=

# Any OpenAI-compatible server: a local vLLM or Ollama, or one on your network.
# Inference you host costs nothing per token, so it is recorded as zero spend
# unless you set explicit rates below. No API key is required.
# AR_MODEL_PROVIDER=openai-compatible
# AR_MODEL_BASE_URL=http://localhost:8000/v1
# AR_MODEL=your-served-model-name

# Keep model inference, SQLite state and publishing local while still allowing
# direct public web search, arXiv/GitHub lookup and HTTP(S) retrieval.
# AR_LOCAL_ONLY=1

# Generic web_search uses Exa's public MCP search endpoint directly and never
# invokes an external model. Override only when using a compatible MCP proxy.
# AR_WEB_SEARCH_MCP_URL=https://mcp.exa.ai/mcp

# Model to use. Only ids beginning "gemini-" are honoured on Google surfaces.
AR_MODEL=gemini-3.7-flash

# Project used for Firestore publishing and for Vertex under ADC.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Halt the research direction once recorded spend reaches this many dollars.
# Checked before each orchestrator turn and each watcher sweep. 0 runs until
# stopped. `research budget --max N` changes it live, without a restart.
AR_MAX_COST_USD=20

# Optional: raise GitHub rate limits for the watcher's code search.
# GITHUB_TOKEN=

node_modules/
dist/
infra/.terraform/
infra/*.tfstate*
infra/terraform.tfvars
__pycache__/
*.pyc
.curi/
.curi-legacy/
.autoresearch/
.autoresearch-legacy/
domains/tinyml/candidate/out/
domains/tinyml/data/*.bin

# Local credentials only. Cloud deployments get configuration from the
# service environment or Secret Manager, never from a file in the image.
.env
.env.*
!.env.example

# Scratch, build output and local tooling: never part of the project.
tmp/
pi-extension/
.autoresearch-legacy-remnants-*/

# Compiled Python artefacts and the legacy campaign harness's protected
# evaluators. The research runtime never reads them: it stores a domain path
# and treats .autoresearch-protected as a name the executor may not touch.
__pycache__/
.autoresearch-protected/
domains/*/candidate/
domains/tinyml/
